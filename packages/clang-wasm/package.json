{
  "name": "@live-codes/clang-wasm",
  "version": "0.1.0",
  "description": "Run C, C++ and Objective-C with one API, on Clang 22 compiled to WebAssembly",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "node": "./src/index.node.js",
      "browser": "./src/index.js",
      "default": "./src/index.js"
    },
    "./iife": "./dist/clang-wasm.global.js"
  },
  "bin": {
    "clang-wasm-copy-assets": "./bin/copy-assets.mjs"
  },
  "files": [
    "src",
    "bin",
    "scripts",
    "dist",
    "assets",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:iife": "node scripts/build-iife.mjs",
    "test": "node --test \"test/*.test.js\""
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "@wasm-idle/llvm-core": "^1.0.0"
  },
  "keywords": [
    "clang",
    "wasm",
    "webassembly",
    "c",
    "c++",
    "objective-c",
    "compiler",
    "playground"
  ]
}
